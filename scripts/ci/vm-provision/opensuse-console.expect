#!/usr/bin/expect -f
# scripts/ci/vm-provision/opensuse-console.expect
#
# Serial-console driver for the openSUSE Tumbleweed AutoYaST install of
# issue #17. Runs ON THE GitLab runner inside a pty, reaching the transient
# guest's serial console through tower:
#
#   ssh -tt tower "sudo virsh console opensuse-tw-install --force"
#
# AutoYaST runs unattended (kickstart-style), so this driver mostly watches:
# it confirms the installer boots, catches early kernel/installer failures,
# waits for the AutoYaST profile to be fetched and the install to complete,
# and enforces the time budget.
#
# argv: <transient-guest> <total_budget_secs>
#
# NOTE on Tcl quoting: expect patterns are ALWAYS brace-quoted
# (e.g. {Installation complete}). A double-quoted pattern string makes Tcl
# run command substitution on [ ... ] inside it — the bug that killed
# job 25904 (alpine322) at its md5 check line.

set timeout 10
log_user 1

set guest  [lindex $argv 0]
set budget [lindex $argv 1]
if {$budget eq ""} { set budget 3000 }
set deadline [expr {[clock seconds] + $budget}]

proc remaining {} { global deadline; return [expr {$deadline - [clock seconds]}] }
proc die {msg} { puts "\nEXPECT-FATAL: $msg"; exit 2 }

proc wait_for {pattern secs} {
    set ::timeout $secs
    expect {
        $pattern { return 1 }
        timeout { die "timeout waiting for: $pattern" }
        eof     { die "console EOF waiting for: $pattern" }
    }
}

# ssh -tt: force a pty on tower's side (job 25780 failed without it).
spawn ssh -tt -o BatchMode=yes -o ConnectTimeout=20 \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile=$env(VM_KNOWN_HOSTS) \
    tower "sudo virsh console $guest --force"

# --- installer boot -------------------------------------------------------
# Direct kernel boot: the kernel loads, then the initrd/InstApp runs
# and YaST/AutoYaST takes over. "Starting installer" is the reliable
# early marker on serial for openSUSE.
wait_for {Starting installer} 900

# --- AutoYaST profile fetch + install -------------------------------------
# AutoYaST prints progress as it reads the profile and starts the
# installation. Watch for either success or fatal error.
set timeout 300
expect {
    {Autoyast profile was read} { }
    {Autoyast.*profile.*read} { }
    {Installation was finished} { }
    {Installation complete} { }
    {Traceback (most recent call last)} { die "installer traceback" }
    eof { die "console EOF during install" }
    timeout {
        if {[remaining] > 0} {
            exp_continue
        } else {
            die "global budget exhausted during kickstart"
        }
    }
}

# --- wait for full install completion -------------------------------------
# The AutoYaST install runs package installation + %post scripts.
# "Installation was finished" or the guest rebooting signals completion.
set timeout 600
expect {
    {Installation was finished} { }
    {Installation complete} { }
    {Rebooting} { }
    {Traceback (most recent call last)} { die "installer traceback during install" }
    eof { die "console EOF during install completion" }
    timeout {
        if {[remaining] > 0} {
            exp_continue
        } else {
            die "global budget exhausted waiting for install completion"
        }
    }
}

# --- reboot ----------------------------------------------------------------
# YaST/AutoYaST reboots the guest to boot from the installed disk.
# The transient domain's on_reboot=force_off shuts it down; console
# closes. Give time for shutdown.
set timeout 180
expect {
    eof { }
    {Domain $guest} { }
    timeout { puts "WARN: no explicit domain shutdown notice on console" }
}
after 5000
close
puts "\nEXPECT-CONSOLE-COMPLETE"
exit 0
