#!/usr/bin/env expect -f
# scripts/ci/vm-provision/ubuntu-24.04-console.expect
#
# Serial-console driver for the Ubuntu 24.04 autoinstall of issue #24
# (parent #7). Runs ON THE GITLAB RUNNER inside a pty (the CI job shell
# allocates one), reaching the guest's serial console through tower:
#
#   ssh -tt tower "sudo virsh console ubuntu2404-install --force"
#
# (the alpine320 pattern from issue #21; tower has no expect binary).
#
# Ubuntu 24.04 subiquity is driven by the autoinstall user-data served over
# HTTP. With autoinstall url=... on the kernel cmdline, subiquity runs
# unattended: it boots the netboot kernel, fetches the user-data, configures
# the network, installs packages, runs the runcmd late-commands, then reboots.
# This driver confirms the installer starts, catches early failures, waits
# for the completion banner, and enforces the time budget.
#
# argv: <transient-guest> <total_budget_secs>
#
# NOTE on Tcl quoting: expect patterns are ALWAYS brace-quoted
# (e.g. {Installation complete}). A double-quoted pattern string makes Tcl run
# command substitution on [ ... ] inside it - the exact bug that killed
# job 25904 (alpine322) at its md5 check line.

set timeout 10
log_user 1

set guest  [lindex $argv 0]
set budget [lindex $argv 1]
if {$budget eq ""} { set budget 3000 }
set deadline [expr {[clock seconds] + $budget}]

proc remaining {} { global deadline; return [expr {$deadline - [clock seconds]}] }
proc die {msg} { puts "\nEXPECT-FATAL: $msg"; exit 2 }

# Drain console output until the pattern appears or the wait budget dies.
proc wait_for {pattern secs} {
	set ::timeout $secs
	expect {
		$pattern { return 1 }
		timeout { die "timeout waiting for: $pattern" }
		eof     { die "console EOF waiting for: $pattern" }
	}
}

# ssh -tt: force a pty on tower's side too (job 25780 failed without it).
spawn ssh -tt -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=accept-new \
	-o UserKnownHostsFile=$env(VM_KNOWN_HOSTS) tower \
	"sudo virsh console $guest --force"

# --- installer boot --------------------------------------------------------
# The netboot kernel loads and subiquity starts. The autoinstall banner is the
# reliable early marker on serial. Ubuntu 24.04 subiquity prints:
#   "subiquity" / "Installing Ubuntu" / "Installing system"
# Kernel + initrd load can take several minutes on tower storage; 900s is
# generous but still bounded.
wait_for {subiquity} 900

# --- autoinstall-driven install ---------------------------------------------
# Subiquity logs progress lines. A fatal installer error aborts early;
# otherwise wait for completion. Ubuntu 24.04 subiquity prints
# "Installation complete" before rebooting. On the serial console subiquity
# may also not flush the banner before the kernel reboots, so we accept the
# post-install login prompt as an equivalent completion signal. A lone
# "[FAILED]" systemd boot line (e.g. NetworkManager-wait-online.service)
# is NOT a subiquity error - it appears during the target OS first boot,
# not during installation.
set timeout 300
expect {
	{Installation complete} { }
	{ubuntu login:} { log "matched login prompt - install completed and system booted" }
	{Login:} { log "matched login prompt - install completed and system booted" }
	{Pane is dead} { die "subiquity pane died (installer error)" }
	{Traceback (most recent call last)} { die "subiquity traceback" }
	{Subiquity ERROR} { puts "\nEXPECT-FATAL: subiquity reported ERROR"; exit 2 }
	{FAILED to start installer} { puts "\nEXPECT-FATAL: installer failed to start"; exit 2 }
	eof { die "console EOF during install" }
	timeout {
		if {[remaining] > 0} {
			# keep watching under the global budget
			exp_continue
		} else {
			die "global budget exhausted during autoinstall"
		}
	}
}

# --- reboot -----------------------------------------------------------------
# autoinstall reboots the guest (on_reboot=destroy on the transient domain):
# the console closes. Give the domain time to power off; the CI driver then
# undefines it.
set timeout 180
expect {
	{Domain $guest} { }
	eof { }
	timeout { puts "WARN: no explicit domain shutdown notice on console" }
}
after 5000
close
puts "\nEXPECT-CONSOLE-COMPLETE"
exit 0
