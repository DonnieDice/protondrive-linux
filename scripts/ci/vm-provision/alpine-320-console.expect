#!/usr/bin/env expect -f
# scripts/ci/vm-provision/alpine-320-console.expect
#
# Serial-console driver for the Alpine 3.20 install of issue #21 (parent #5).
# Runs ON THE GITLAB RUNNER inside a pty (the CI job allocates it), not on the
# tower host: tower has no expect binary (the #22 sibling proved that route
# fails rc=127). The runner connects the pty through tower with:
#
#   ssh -tt tower "sudo virsh console alpine320-install --force"
#
# so the expect process on the runner drives the guest's serial console over
# the SSH transport. argv (all required):
#   <guest> <payload_port> <payload_md5> <total_budget_secs>
#
# Flow (the transient domain boots the ISO kernel directly with
# console=ttyS0,115200; Alpine's initramfs setup_inittab_console() spawns a
# getty for every console= param, so a login: prompt appears on serial):
#   1. wait for the live env's login: prompt; log in as root (no password)
#   2. bring up eth0 with the static IP + default route + DNS (the live
#      install fetches from the v3.20 network mirror, which is not on the
#      standard ISO media)
#   3. start an nc listener that prints PAYLOAD_ARRIVED when the CI-side
#      pusher closes the connection; print the NC_READY marker (the CI job
#      greps the console log for it and pushes the payload bundle over the
#      LAN)
#   4. verify the payload md5, explode it
#   5. run the live install (setup-disk), watch for INSTALL_DONE
#   6. chroot post-config, watch for the done marker
#   7. power the guest off
#
# Tcl quoting rules that bit the #22 sibling and are honored here:
#   - every expect regex uses BRACE quoting: inside double quotes Tcl
#     evaluates [ ... ] as command substitution, so -re "LIVE_RC=[1-9]"
#     dies with 'invalid command name "0-9a-f"' (job 25904, line 100).
#   - shell sync markers are split in the SENT text (echo P""ING) so the
#     console echo of the command can never satisfy the wait_for matcher;
#     only the command's OUTPUT contains the joined marker.
#
# No secret material crosses this console: the workforce key's public half
# arrives inside the LAN payload; the private half never leaves the runner.
set timeout 10
log_user 1
# log_file mirrors everything the console emits into the CI-side log with
# expect's own per-read flushing. The payload pusher greps THIS file for
# NC_READY; expect's stdout alone is block-buffered when piped through tee,
# so without log_file the pusher could wait past its budget on a marker the
# guest printed minutes earlier. The install script exports CONSOLE_LOG with
# the absolute path inside provision-results/ so the log lands in artifacts
# where the pusher greps it.
if {[info exists env(CONSOLE_LOG)]} {
	log_file -noappend $env(CONSOLE_LOG)
}

set guest    [lindex $argv 0]
set port     [lindex $argv 1]
set paymd5   [lindex $argv 2]
set budget   [lindex $argv 3]
set deadline [expr {[clock seconds] + $budget}]

proc remaining {} { global deadline; return [expr {$deadline - [clock seconds]}] }
proc die {msg} { puts "\nEXPECT-FATAL: $msg"; exit 2 }

# The transient domain may already be mid-boot from a prior attempt: after
# spawn, drain whatever the console emits until the pattern or timeout.
proc wait_for {pattern secs} {
	set ::timeout $secs
	expect {
		$pattern { return 1 }
		timeout { die "timeout waiting for: $pattern" }
		eof     { die "console EOF waiting for: $pattern" }
	}
}

# Deterministic shell sync: the busybox prompt is "host:~# " followed by an
# ANSI cursor query (ESC[6n), so anchoring on the prompt shape is unreliable.
# Instead: send a command whose OUTPUT is a unique joined marker, split in
# the echoed command text so the echo itself cannot match, then wait for it.
set sync_seq 0
proc sync_shell {} {
	global sync_seq
	incr sync_seq
	set marker "PROMPT_SYNCED_${sync_seq}"
	send "echo PROMPT_SYN\"\"CED_${sync_seq}\r"
	wait_for $marker 90
}

# ssh -tt: force pty allocation on tower even though the local command is not
# interactive (expect's spawn gives the local side a pty; virsh console
# demands one on its own controlling side too - the #22 sibling's job 25780
# failed without -tt).
spawn ssh -tt -o BatchMode=yes -o ConnectTimeout=20 -o StrictHostKeyChecking=accept-new \
	-o UserKnownHostsFile=$env(VM_KNOWN_HOSTS) tower \
	"sudo virsh console $guest --force"

# --- login on the serial getty --------------------------------------------
# live env: root has no password; the login name alone logs in
wait_for "login:" 300
after 1000
send "root\r"

# --- static network in the live env ----------------------------------------
after 2000
send "ip addr add 192.168.1.157/24 dev eth0 && ip link set eth0 up\r"
send "ip route add default via 192.168.1.1\r"
send "printf 'nameserver 192.168.1.1\\nnameserver 1.1.1.1\\n' > /etc/resolv.conf\r"
after 1000
send "ip -4 addr show eth0 | grep inet\r"

# --- payload listener --------------------------------------------------------
# The listener is backgrounded as a whole list; when the CI pusher closes
# the connection (or the 30s idle read timeout fires) nc exits and the
# second marker prints - only then is /tmp/payload.tgz complete, so there is
# no md5 race against the CI-side 10s-poll pusher. Both markers are split
# in the sent text so their command echoes can never match a grep.
send "nc -l -p $port -w 30 > /tmp/payload.tgz && echo PAYLOAD_ARR\"\"IVED &\r"
after 500
send "echo NC_RE\"\"ADY\r"
wait_for "NC_READY" 120

# (the CI job pushes the bundle now; the guest prints PAYLOAD_ARRIVED when
# the listener exits - nc exits on sender close or after 30s idle)
wait_for "PAYLOAD_ARRIVED" 600

# --- verify + explode payload -----------------------------------------------
send "ls -la /tmp/payload.tgz\r"
# md5 comes from the md5sum OUTPUT line. Brace-quoted: inside double quotes
# Tcl would evaluate [0-9a-f] as a command substitution (the exact defect
# that killed the #22 sibling's driver at this step, job 25904 line 100).
send "md5sum /tmp/payload.tgz\r"
expect -re {([0-9a-f]{32})}
if {$paymd5 ne $expect_out(1,string)} {
	send "echo MD5_MISMATCH\r"
	die "payload md5 mismatch (expected $paymd5)"
}
send "echo MD5_OK\r"
send "tar -xzf /tmp/payload.tgz -C /root && ls -la /root\r"
sync_shell
send "chmod +x /root/live-install.sh /root/chroot-config.sh\r"
sync_shell

# --- live install -------------------------------------------------------------
send "sh /root/live-install.sh; echo LIVE_RC=\$?\r"
set timeout 1500
expect {
	"INSTALL_DONE" {}
	"INSTALL_FAILED" { die "live-install reported INSTALL_FAILED" }
	-re {LIVE_RC=[1-9]} { die "live-install exited nonzero" }
	timeout { die "timeout during setup-disk" }
	eof { die "console EOF during live-install" }
}

# --- chroot post-config --------------------------------------------------------
send "mount /dev/vda2 /mnt\r"
after 1000
send "mount -t proc proc /mnt/proc && mount --rbind /sys /mnt/sys && mount --rbind /dev /mnt/dev\r"
after 1000
send "cp -L /etc/resolv.conf /mnt/etc/ && cp /root/chroot-config.sh /root/hermes-key.pub /mnt/root/\r"
after 1000
send "chroot /mnt sh /root/chroot-config.sh; echo CHROOT_RC=\$?\r"
set timeout 1200
expect {
	"chroot-config done" {}
	-re {CHROOT_RC=[1-9]} { die "chroot-config exited nonzero" }
	timeout { die "timeout during chroot-config" }
	eof { die "console EOF during chroot-config" }
}
send "umount -R /mnt/proc /mnt/sys /mnt/dev 2>/dev/null; umount /mnt\r"
after 3000

# --- poweroff -------------------------------------------------------------------
send "poweroff\r"
set timeout 180
expect {
	"Power down" {}
	"shut off" {}
	-re {The system is going down} {}
	timeout { puts "WARN: no explicit poweroff confirmation on console" }
	eof { puts "WARN: console closed at poweroff (guest may have shut down)" }
}
after 15000
close
puts "\nEXPECT-CONSOLE-COMPLETE"
exit 0
